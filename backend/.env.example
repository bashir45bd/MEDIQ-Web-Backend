# -------------------------------------------------------------
# MEDIQ — Environment Configuration Template
# Copy to .env and configure for your local/production environment
# -------------------------------------------------------------

# Application
APP_NAME=MEDIQ
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.mediq.com.bd
APP_TIMEZONE=Asia/Dhaka

# Database Configuration (MySQL 8+ / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediq_prod
DB_USERNAME=mediq_user
DB_PASSWORD=secret_db_password_change_me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Authentication & JWT
JWT_SECRET=generate_a_minimum_64_character_cryptographic_random_key_here
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# Platform Business Settings
DEFAULT_PLATFORM_FEE=50.00
NO_SHOW_GRACE_MINUTES=10
WAITLIST_CLAIM_WINDOW_MINS=15

# File Storage
STORAGE_DRIVER=local
STORAGE_BASE_PATH=/var/www/mediq/backend/storage

# SMS Gateway (Bangladeshi Aggregator / Mock)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=MEDIQ
SMS_API_URL=https://api.sms-provider.com.bd/v3/send

# Payment Gateway - bKash
BKASH_ENV=sandbox
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=https://api.mediq.com.bd/api/v1/payments/webhook/bkash

# Payment Gateway - Nagad
NAGAD_ENV=sandbox
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key
NAGAD_CALLBACK_URL=https://api.mediq.com.bd/api/v1/payments/webhook/nagad

# SMTP / Email Notifications
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.mediq.com.bd
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@mediq.com.bd
MAIL_FROM_NAME="MEDIQ Healthcare"
